DATABASE_URL=sqlite:///./cybercare.db
# Gere: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENVIRONMENT=local
DEMO_MODE=true
# Hospedagem: true para cadastrar explicitamente as contas e casos fictícios na inicialização.
SEED_DEMO=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PRIVACY_THRESHOLD=5
RETENTION_DAYS=30
SUPPORT_NAME=
SUPPORT_CONTACT=
# Somente para python -m app.seed; mínimo 12 caracteres, diferentes por perfil.
DEMO_STAFF_PASSWORD=
DEMO_MANAGER_PASSWORD=
